      Parameter {
        Variable      "Declarations"
        Value         "#define Gain 10   //defining gain\n"
"//linking inputs\n"
"#define In_1 InputSignal(0,0)\n"
"#define In_2 InputSignal(0,1)\n"
"//includes\n"
"#include \"stdint.h\"\n"
"\n"
"static float A; //Accumlated output\n"
"\n"
"void accum_diff(uint16_t B,uint16_t C);  //func proto\n"
"\n"
"float return_A(void);  //func proto\n"
"\n"
"void accum_diff(uint16_t B,uint16_t C){\n"
"A = (B -C)*Gain + A;\n"
"}\n"
"\n"
"\n"
"float return_A(void){\n"
"return A;\n"
"}"
