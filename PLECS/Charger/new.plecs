"Dbody  20    3    DBODY\n"
".MODEL DBODY D(IS=2.2E-12    N=1.0     RS=18.3m    EG=1.11    TT=110n)\n"
"Ra      4    2    8.0m   TC=0.008\n"
"Rs      3    5    1.2m    \n"
"Ls      5   30    2.3n\n"
"M2      1    8    6    6    INTER\n"
"E2      8    6    4    1    2\n"
".MODEL INTER PMOS (VTO=0   KP=10   LEVEL=1)\n"
"Cgdmax  7    4    2795P\n"
"Rcgd    7    4    10meg\n"
"Dgd     4    6    DGD\n"
"Rdgd    4    6    10meg\n"
".MODEL DGD   D(M=0.85   CJO=2795P    VJ=0.45)\n"
"M3      7    9    1    1    INTER\n"
"E3      9    1    4    1    -2\n"
".ENDS FQB22P10\n"
"*----------------------------------------------------------------------------"
"---------\n"
"*FAIRCHILD      CASE: D2-PAK      PID: FQB22P10 \n"
"*APR-20-2002 CREATION    \n"
